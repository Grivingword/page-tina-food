---
---

<section class="relative min-h-screen bg-gradient-to-br from-dark-900 via-dark-800 to-dark-900 overflow-hidden pt-20" id="home">
	<!-- Animated Background Elements -->
	<div class="absolute inset-0 overflow-hidden">
		<div class="absolute top-20 left-10 w-32 h-32 bg-primary-500/10 rounded-full blur-xl animate-float"></div>
		<div class="absolute top-40 right-20 w-24 h-24 bg-secondary-500/10 rounded-full blur-xl animate-float" style="animation-delay: 2s;"></div>
		<div class="absolute bottom-40 left-1/4 w-40 h-40 bg-primary-400/5 rounded-full blur-2xl animate-pulse-slow"></div>
	</div>
	
	<!-- Main Background Gradient -->
	<div class="absolute top-0 right-0 w-3/5 h-full bg-gradient-to-br from-primary-500/20 to-primary-600/30 clip-path-polygon"></div>
	
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
		<div class="grid lg:grid-cols-2 gap-12 items-center min-h-[85vh]">
			<!-- Left Content -->
			<div class="space-y-8 animate-slide-up">
				<!-- Rating Badge -->
				<div class="flex items-center gap-4 bg-white/10 backdrop-blur-md px-6 py-4 rounded-full w-fit border border-primary-500/20 hover:scale-105 transition-all duration-300">
					<div class="flex text-yellow-400 text-lg">
						<span class="animate-bounce">⭐</span>
						<span class="animate-bounce" style="animation-delay: 0.1s;">⭐</span>
						<span class="animate-bounce" style="animation-delay: 0.2s;">⭐</span>
						<span class="animate-bounce" style="animation-delay: 0.3s;">⭐</span>
						<span class="animate-bounce" style="animation-delay: 0.4s;">⭐</span>
					</div>
					<span class="text-white font-semibold">4.9 Reseñas Felices</span>
				</div>
				
				<!-- Hero Text -->
				<div class="space-y-6">
					<p class="text-primary-400 text-lg font-bold uppercase tracking-wider animate-fade-in">
						¡Sabores que Conquistan!
					</p>
					<h1 class="text-5xl lg:text-7xl font-black leading-tight animate-scale-in">
						<span class="text-white">Hamburguesas</span><br>
						<span class="bg-gradient-to-r from-primary-400 via-primary-500 to-primary-600 bg-clip-text text-transparent animate-pulse-slow">
							Épicas
						</span>
					</h1>
					<p class="text-gray-300 text-xl leading-relaxed max-w-lg animate-fade-in" style="animation-delay: 0.3s;">
						Descubre el sabor auténtico con ingredientes frescos y recetas únicas que harán de cada bocado una experiencia inolvidable.
					</p>
				</div>

				<!-- Action Buttons -->
				<div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 animate-fade-in" style="animation-delay: 0.5s;">
					<a href="#menu" class="group bg-gradient-to-r from-primary-500 to-primary-600 text-white px-8 py-4 rounded-full font-bold text-lg hover:from-primary-600 hover:to-primary-700 hover:scale-105 hover:shadow-2xl hover:shadow-primary-500/25 transition-all duration-300 flex items-center gap-3">
						<span>Explorar Menú</span>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="group-hover:translate-x-1 transition-transform duration-300">
							<path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
						</svg>
					</a>
					<button class="group flex items-center gap-4 text-white font-semibold hover:text-primary-400 transition-all duration-300">
						<div class="w-14 h-14 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center text-primary-400 group-hover:bg-primary-500 group-hover:text-white group-hover:scale-110 transition-all duration-300">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
								<path d="M8 5V19L19 12L8 5Z"/>
							</svg>
						</div>
						<span class="text-lg">Ver Video</span>
					</button>
				</div>
			</div>

			<!-- Right Content - Food Showcase -->
			<div class="relative h-96 lg:h-[600px] animate-fade-in" style="animation-delay: 0.7s;">
				<!-- Main Burger -->
				<div class="absolute top-0 right-0 z-30 group">
					<img 
						src="https://images.pexels.com/photos/1556909/pexels-photo-1556909.jpeg?auto=compress&cs=tinysrgb&w=400&h=400&fit=crop" 
						alt="Hamburguesa Deliciosa" 
						class="w-80 h-80 lg:w-96 lg:h-96 object-cover rounded-3xl shadow-2xl shadow-black/50 transition-all duration-500 group-hover:scale-105 group-hover:rotate-2"
					>
					<div class="absolute -top-4 -right-4 bg-primary-500 text-white px-4 py-2 rounded-full font-bold text-sm animate-bounce">
						¡Nuevo!
					</div>
				</div>
				
				<!-- Secondary Images -->
				<div class="absolute bottom-0 left-0 z-20 group">
					<img 
						src="https://images.pexels.com/photos/3004909/pexels-photo-3004909.jpeg?auto=compress&cs=tinysrgb&w=300&h=300&fit=crop" 
						alt="Alitas Crujientes" 
						class="w-64 h-64 lg:w-72 lg:h-72 object-cover rounded-3xl shadow-2xl shadow-black/40 transition-all duration-500 group-hover:scale-105 group-hover:-rotate-2"
					>
				</div>
				
				<!-- Floating Food Elements -->
				<div class="absolute inset-0 pointer-events-none">
					<div class="absolute top-1/4 left-1/12 text-4xl animate-float">🍟</div>
					<div class="absolute top-3/5 right-1/5 text-4xl animate-float" style="animation-delay: 1s;">🍅</div>
					<div class="absolute bottom-1/3 left-1/3 text-4xl animate-float" style="animation-delay: 2s;">🧅</div>
					<div class="absolute top-1/2 right-1/3 text-3xl animate-float" style="animation-delay: 1.5s;">🥬</div>
				</div>

				<!-- Decorative Elements -->
				<div class="absolute top-10 left-10 w-20 h-20 border-4 border-primary-500/30 rounded-full animate-rotate-slow"></div>
				<div class="absolute bottom-20 right-10 w-16 h-16 bg-gradient-to-r from-primary-500 to-secondary-500 rounded-full opacity-20 animate-pulse-slow"></div>
			</div>
		</div>

		<!-- Business Info Cards -->
		<div class="grid md:grid-cols-3 gap-6 my-16 animate-slide-up" style="animation-delay: 1s;">
			<div class="group flex items-center gap-4 bg-white/5 backdrop-blur-md p-6 rounded-2xl border border-primary-500/20 hover:bg-primary-500/10 hover:scale-105 hover:border-primary-500/40 transition-all duration-300">
				<div class="w-14 h-14 bg-gradient-to-r from-primary-500 to-primary-600 rounded-full flex items-center justify-center text-2xl group-hover:scale-110 transition-transform duration-300">🕒</div>
				<div>
					<h4 class="text-white font-bold text-lg">Hoy 10:00am - 10:00pm</h4>
					<p class="text-gray-300">Horario de atención</p>
				</div>
			</div>
			
			<div class="group flex items-center gap-4 bg-white/5 backdrop-blur-md p-6 rounded-2xl border border-primary-500/20 hover:bg-primary-500/10 hover:scale-105 hover:border-primary-500/40 transition-all duration-300">
				<div class="w-14 h-14 bg-gradient-to-r from-primary-500 to-primary-600 rounded-full flex items-center justify-center text-2xl group-hover:scale-110 transition-transform duration-300">📍</div>
				<div>
					<h4 class="text-white font-bold text-lg">Ciudad de México</h4>
					<p class="text-gray-300">Nuestra ubicación</p>
				</div>
			</div>
			
			<div class="group flex items-center gap-4 bg-white/5 backdrop-blur-md p-6 rounded-2xl border border-primary-500/20 hover:bg-primary-500/10 hover:scale-105 hover:border-primary-500/40 transition-all duration-300">
				<div class="w-14 h-14 bg-gradient-to-r from-primary-500 to-primary-600 rounded-full flex items-center justify-center text-2xl group-hover:scale-110 transition-transform duration-300">📞</div>
				<div>
					<h4 class="text-white font-bold text-lg">+52 55 1234 5678</h4>
					<p class="text-gray-300">Número de teléfono</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.clip-path-polygon {
		clip-path: polygon(25% 0%, 100% 0%, 100% 100%, 0% 100%);
	}
</style>