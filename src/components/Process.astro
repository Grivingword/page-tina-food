---
---

<section class="py-20 bg-gradient-to-br from-dark-800 to-dark-900 relative overflow-hidden" id="about">
	<!-- Background Elements -->
	<div class="absolute inset-0 opacity-10">
		<div class="absolute top-10 left-10 w-32 h-32 bg-primary-500 rounded-full blur-3xl animate-pulse-slow"></div>
		<div class="absolute bottom-10 right-10 w-40 h-40 bg-secondary-500 rounded-full blur-3xl animate-pulse-slow" style="animation-delay: 2s;"></div>
	</div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
		<div class="text-center mb-16 animate-fade-in">
			<div class="inline-flex items-center gap-3 bg-primary-500/10 backdrop-blur-md px-6 py-3 rounded-full border border-primary-500/20 mb-6">
				<span class="text-2xl animate-bounce">⚡</span>
				<span class="text-primary-400 font-bold uppercase tracking-wider">Nuestro Proceso</span>
			</div>
			<h2 class="text-4xl lg:text-5xl font-black text-white mb-6">
				La Comida Es Una Parte Importante De Una Dieta Balanceada
			</h2>
			<p class="text-gray-300 text-xl max-w-3xl mx-auto leading-relaxed">
				Desde la selección de ingredientes hasta la entrega, cada paso está diseñado para brindarte la mejor experiencia gastronómica.
			</p>
		</div>

		<div class="grid lg:grid-cols-3 gap-12 items-center">
			<!-- Step 1: Elegir -->
			<div class="text-center lg:text-right space-y-6 animate-slide-up" style="animation-delay: 0.2s;">
				<div class="relative inline-block lg:ml-auto">
					<div class="relative group">
						<img 
							src="https://images.pexels.com/photos/4393426/pexels-photo-4393426.jpeg?auto=compress&cs=tinysrgb&w=350&h=250&fit=crop" 
							alt="Elegir" 
							class="w-full max-w-sm mx-auto lg:ml-auto rounded-3xl shadow-2xl transition-all duration-500 group-hover:scale-105 group-hover:shadow-primary-500/25"
						>
						<div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent rounded-3xl"></div>
					</div>
					<div class="absolute -top-6 -right-6 w-16 h-16 bg-gradient-to-r from-primary-500 to-primary-600 rounded-full flex items-center justify-center text-white font-black text-2xl shadow-2xl animate-bounce">
						1
					</div>
					<div class="absolute -bottom-4 -left-4 w-12 h-12 bg-secondary-500 rounded-full animate-pulse"></div>
				</div>
				<div class="space-y-4">
					<h3 class="text-3xl font-black text-primary-400 mb-4">ELEGIR</h3>
					<p class="text-gray-300 leading-relaxed text-lg">
						Selecciona de nuestro amplio menú con ingredientes frescos y orgánicos. Cada platillo está diseñado para ofrecerte una experiencia única y saludable.
					</p>
					<div class="flex justify-center lg:justify-end gap-2">
						<div class="w-2 h-2 bg-primary-500 rounded-full animate-bounce"></div>
						<div class="w-2 h-2 bg-primary-500 rounded-full animate-bounce" style="animation-delay: 0.1s;"></div>
						<div class="w-2 h-2 bg-primary-500 rounded-full animate-bounce" style="animation-delay: 0.2s;"></div>
					</div>
				</div>
			</div>

			<!-- Step 2: Preparar (Centro) -->
			<div class="text-center space-y-6 animate-scale-in" style="animation-delay: 0.4s;">
				<div class="relative mx-auto">
					<div class="w-40 h-40 bg-gradient-to-br from-primary-500 via-primary-600 to-primary-700 rounded-full flex items-center justify-center mx-auto mb-6 shadow-2xl shadow-primary-500/50 relative overflow-hidden group">
						<div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -skew-x-12 transform -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></div>
						<img 
							src="https://images.pexels.com/photos/1556909/pexels-photo-1556909.jpeg?auto=compress&cs=tinysrgb&w=120&h=120&fit=crop" 
							alt="Preparar Comida" 
							class="w-28 h-28 rounded-full object-cover border-4 border-white/20 relative z-10"
						>
					</div>
					<div class="absolute -top-4 left-1/2 transform -translate-x-1/2 w-10 h-10 bg-gradient-to-r from-secondary-500 to-secondary-600 rounded-full flex items-center justify-center text-white font-black text-lg animate-bounce">
						2
					</div>
					
					<!-- Floating elements around the center -->
					<div class="absolute top-0 left-0 text-2xl animate-float">👨‍🍳</div>
					<div class="absolute top-0 right-0 text-2xl animate-float" style="animation-delay: 1s;">🔥</div>
					<div class="absolute bottom-0 left-0 text-2xl animate-float" style="animation-delay: 2s;">⏰</div>
					<div class="absolute bottom-0 right-0 text-2xl animate-float" style="animation-delay: 3s;">✨</div>
				</div>
				
				<div class="border-2 border-dashed border-primary-500/50 rounded-3xl p-8 bg-primary-500/5 backdrop-blur-md hover:border-primary-500 hover:bg-primary-500/10 transition-all duration-300">
					<h3 class="text-3xl font-black text-primary-400 mb-4">PREPARAR COMIDA</h3>
					<p class="text-gray-300 leading-relaxed text-lg">
						Nuestros chefs expertos preparan cada platillo con técnicas culinarias de vanguardia, garantizando frescura, sabor y presentación excepcional en cada orden.
					</p>
					<div class="flex justify-center gap-3 mt-6">
						<div class="px-4 py-2 bg-primary-500/20 rounded-full text-primary-400 text-sm font-semibold">Fresco</div>
						<div class="px-4 py-2 bg-secondary-500/20 rounded-full text-secondary-400 text-sm font-semibold">Rápido</div>
						<div class="px-4 py-2 bg-purple-500/20 rounded-full text-purple-400 text-sm font-semibold">Delicioso</div>
					</div>
				</div>
			</div>

			<!-- Step 3: Entregar -->
			<div class="text-center lg:text-left space-y-6 animate-slide-up" style="animation-delay: 0.6s;">
				<div class="relative inline-block lg:mr-auto">
					<div class="relative group">
						<img 
							src="https://images.pexels.com/photos/4393426/pexels-photo-4393426.jpeg?auto=compress&cs=tinysrgb&w=350&h=250&fit=crop" 
							alt="Entregar" 
							class="w-full max-w-sm mx-auto lg:mr-auto rounded-3xl shadow-2xl transition-all duration-500 group-hover:scale-105 group-hover:shadow-primary-500/25"
						>
						<div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent rounded-3xl"></div>
					</div>
					<div class="absolute -top-6 -left-6 w-16 h-16 bg-gradient-to-r from-secondary-500 to-secondary-600 rounded-full flex items-center justify-center text-white font-black text-2xl shadow-2xl animate-bounce">
						3
					</div>
					<div class="absolute -bottom-4 -right-4 w-12 h-12 bg-primary-500 rounded-full animate-pulse"></div>
				</div>
				<div class="space-y-4">
					<h3 class="text-3xl font-black text-primary-400 mb-4">ENTREGAR</h3>
					<p class="text-gray-300 leading-relaxed text-lg">
						Entrega rápida y segura directo a tu puerta. Mantenemos la temperatura y calidad perfecta para que disfrutes tu comida como recién preparada.
					</p>
					<div class="flex justify-center lg:justify-start gap-4 mt-6">
						<div class="flex items-center gap-2 text-primary-400">
							<div class="w-3 h-3 bg-primary-500 rounded-full animate-pulse"></div>
							<span class="text-sm font-semibold">Entrega en 30 min</span>
						</div>
						<div class="flex items-center gap-2 text-secondary-400">
							<div class="w-3 h-3 bg-secondary-500 rounded-full animate-pulse"></div>
							<span class="text-sm font-semibold">Seguimiento en tiempo real</span>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Process Stats -->
		<div class="grid md:grid-cols-4 gap-6 mt-20 animate-fade-in" style="animation-delay: 0.8s;">
			<div class="text-center group">
				<div class="w-20 h-20 bg-gradient-to-r from-primary-500 to-primary-600 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
					<span class="text-3xl">⚡</span>
				</div>
				<h4 class="text-3xl font-black text-white mb-2">15min</h4>
				<p class="text-gray-400">Tiempo promedio de preparación</p>
			</div>
			
			<div class="text-center group">
				<div class="w-20 h-20 bg-gradient-to-r from-secondary-500 to-secondary-600 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
					<span class="text-3xl">🏆</span>
				</div>
				<h4 class="text-3xl font-black text-white mb-2">100%</h4>
				<p class="text-gray-400">Ingredientes frescos</p>
			</div>
			
			<div class="text-center group">
				<div class="w-20 h-20 bg-gradient-to-r from-purple-500 to-purple-600 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
					<span class="text-3xl">🚚</span>
				</div>
				<h4 class="text-3xl font-black text-white mb-2">30min</h4>
				<p class="text-gray-400">Entrega garantizada</p>
			</div>
			
			<div class="text-center group">
				<div class="w-20 h-20 bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
					<span class="text-3xl">⭐</span>
				</div>
				<h4 class="text-3xl font-black text-white mb-2">4.9</h4>
				<p class="text-gray-400">Calificación promedio</p>
			</div>
		</div>
	</div>
</section>