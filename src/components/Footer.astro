---
---
<!-- bg-dark-900  -->
<footer class="bg-gradient-to-br from-dark-800 to-dark-900 pt-20 pb-8 relative overflow-hidden">
	<!-- Background Pattern -->
	<div class="absolute inset-0 opacity-5">
		<div class="absolute top-20 left-20 w-40 h-40 bg-primary-500 rounded-full blur-3xl animate-pulse-slow"></div>
		<div class="absolute bottom-20 right-20 w-32 h-32 bg-secondary-500 rounded-full blur-3xl animate-pulse-slow" style="animation-delay: 2s;"></div>
	</div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
		<div class="grid lg:grid-cols-4 gap-12 mb-12">
			<!-- Company Info -->
			<div class="lg:col-span-2 animate-fade-in">
				<div class="flex items-center gap-4 mb-6 group">
					<div class="relative">
						<div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-full flex items-center justify-center group-hover:scale-110 transition-all duration-300">
							<span class="text-white font-black text-2xl">🍔</span>
						</div>
						<div class="absolute -top-2 -right-2 w-6 h-6 bg-secondary-500 rounded-full animate-pulse"></div>
					</div>
					<div>
						<span class="text-3xl font-black text-white tracking-tight">TINA</span>
						<div class="text-sm text-primary-400 font-bold -mt-1">FOOD</div>
					</div>
				</div>
				<p class="text-gray-300 leading-relaxed mb-6 max-w-md text-lg">
					Somos más que un restaurante, somos una experiencia gastronómica única. Ingredientes frescos, sabores auténticos y la pasión por crear momentos inolvidables en cada bocado.
				</p>
				
				<!-- Contact Info -->
				<div class="space-y-4">
					<div class="flex items-center gap-4 group">
						<div class="w-12 h-12 bg-primary-500/20 rounded-full flex items-center justify-center group-hover:bg-primary-500 transition-colors duration-300">
							<span class="text-xl">📞</span>
						</div>
						<div>
							<p class="text-white font-semibold">+52 55 1234 5678</p>
							<p class="text-gray-400 text-sm">Línea directa</p>
						</div>
					</div>
					<div class="flex items-center gap-4 group">
						<div class="w-12 h-12 bg-primary-500/20 rounded-full flex items-center justify-center group-hover:bg-primary-500 transition-colors duration-300">
							<span class="text-xl">✉️</span>
						</div>
						<div>
							<p class="text-white font-semibold">hola@tinafood.com</p>
							<p class="text-gray-400 text-sm">Atención al cliente</p>
						</div>
					</div>
					<div class="flex items-center gap-4 group">
						<div class="w-12 h-12 bg-primary-500/20 rounded-full flex items-center justify-center group-hover:bg-primary-500 transition-colors duration-300">
							<span class="text-xl">📍</span>
						</div>
						<div>
							<p class="text-white font-semibold">Ciudad de México, CDMX</p>
							<p class="text-gray-400 text-sm">Nuestra ubicación</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Services -->
			<div class="animate-fade-in" style="animation-delay: 0.2s;">
				<h3 class="text-white font-black text-xl mb-6 flex items-center gap-3">
					<span class="w-2 h-8 bg-primary-500 rounded-full"></span>
					Servicios
				</h3>
				<ul class="space-y-4">
					<li><a href="#menu" class="footer-link group">
						<span>🍔</span>
						<span>Hamburguesas</span>
					</a></li>
					<li><a href="#menu" class="footer-link group">
						<span>🍗</span>
						<span>Alitas</span>
					</a></li>
					<li><a href="#menu" class="footer-link group">
						<span>🌭</span>
						<span>Hot Dogs</span>
					</a></li>
					<li><a href="#menu" class="footer-link group">
						<span>🍟</span>
						<span>Acompañamientos</span>
					</a></li>
					<li><a href="#about" class="footer-link group">
						<span>ℹ️</span>
						<span>Nosotros</span>
					</a></li>
				</ul>
			</div>

			<!-- Follow Us & Quick Links -->
			<div class="animate-fade-in" style="animation-delay: 0.4s;">
				<h3 class="text-white font-black text-xl mb-6 flex items-center gap-3">
					<span class="w-2 h-8 bg-secondary-500 rounded-full"></span>
					Síguenos
				</h3>
				<ul class="space-y-4 mb-8">
					<li><a href="#" class="footer-link group">
						<span>📱</span>
						<span>Instagram</span>
					</a></li>
					<li><a href="#" class="footer-link group">
						<span>📘</span>
						<span>Facebook</span>
					</a></li>
					<li><a href="#" class="footer-link group">
						<span>🐦</span>
						<span>Twitter</span>
					</a></li>
					<li><a href="#" class="footer-link group">
						<span>📺</span>
						<span>TikTok</span>
					</a></li>
				</ul>

				<!-- Quick Subscribe -->
				<div class="bg-gradient-to-r from-primary-500/20 to-primary-600/20 backdrop-blur-md p-6 rounded-2xl border border-primary-500/30">
					<h4 class="text-white font-bold text-lg mb-3">Ofertas Exclusivas</h4>
					<p class="text-gray-300 text-sm mb-4">Suscríbete para recibir descuentos especiales</p>
					<form class="flex gap-2">
						<input 
							type="email" 
							placeholder="Tu email..." 
							class="flex-1 px-3 py-2 rounded-lg text-gray-900 placeholder-gray-500 focus:outline-none text-sm"
							required
						>
						<button 
							type="submit" 
							class="bg-primary-500 text-white px-4 py-2 rounded-lg hover:bg-primary-600 transition-colors duration-300 font-semibold text-sm"
						>
							→
						</button>
					</form>
				</div>
			</div>
		</div>

		<!-- Bottom Bar -->
		<div class="border-t border-gray-800 pt-8 animate-fade-in" style="animation-delay: 0.6s;">
			<div class="flex flex-col md:flex-row justify-between items-center gap-6">
				<div class="flex flex-col md:flex-row items-center gap-4">
					<p class="text-gray-400 text-sm">
						© 2024 TINA FOOD. Todos los derechos reservados.
					</p>
					<div class="flex items-center gap-2 text-gray-400 text-sm">
						<span>Hecho con</span>
						<span class="text-red-500 animate-pulse">❤️</span>
						<span>en México</span>
					</div>
				</div>
				
				<div class="flex flex-wrap justify-center gap-6">
					<a href="#" class="text-gray-400 hover:text-primary-400 transition-colors duration-300 text-sm font-semibold">Política de Privacidad</a>
					<a href="#" class="text-gray-400 hover:text-primary-400 transition-colors duration-300 text-sm font-semibold">Términos de Servicio</a>
					<a href="#" class="text-gray-400 hover:text-primary-400 transition-colors duration-300 text-sm font-semibold">Cookies</a>
				</div>
			</div>

			<!-- Additional Info -->
			<div class="mt-8 pt-6 border-t border-gray-800/50">
				<div class="grid md:grid-cols-3 gap-6 text-center">
					<div class="group">
						<div class="text-2xl mb-2 group-hover:scale-110 transition-transform duration-300">🚚</div>
						<h5 class="text-white font-semibold mb-1">Entrega Rápida</h5>
						<p class="text-gray-400 text-sm">30 minutos o menos</p>
					</div>
					<div class="group">
						<div class="text-2xl mb-2 group-hover:scale-110 transition-transform duration-300">🌱</div>
						<h5 class="text-white font-semibold mb-1">Ingredientes Frescos</h5>
						<p class="text-gray-400 text-sm">100% naturales y locales</p>
					</div>
					<div class="group">
						<div class="text-2xl mb-2 group-hover:scale-110 transition-transform duration-300">⭐</div>
						<h5 class="text-white font-semibold mb-1">Calidad Garantizada</h5>
						<p class="text-gray-400 text-sm">Satisfacción del 100%</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer-link {
		@apply flex items-center gap-3 text-gray-300 hover:text-primary-400 transition-all duration-300 py-2 px-3 rounded-lg hover:bg-primary-500/10;
	}
	
	.footer-link:hover span:first-child {
		@apply scale-110;
	}
</style>