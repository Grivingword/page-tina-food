---
---

<section class="py-20 bg-gradient-to-br from-primary-500 via-primary-600 to-primary-700 relative overflow-hidden" id="contact">
	<!-- Background Elements -->
	<div class="absolute inset-0 opacity-20">
		<div class="absolute top-10 left-10 w-32 h-32 bg-white rounded-full blur-3xl animate-float"></div>
		<div class="absolute bottom-10 right-10 w-40 h-40 bg-white rounded-full blur-3xl animate-float" style="animation-delay: 2s;"></div>
		<div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-60 h-60 bg-white rounded-full blur-3xl animate-pulse-slow"></div>
	</div>

	<!-- Decorative Pattern -->
	<div class="absolute inset-0 opacity-10">
		<div class="absolute top-20 left-20 text-6xl animate-float">🍔</div>
		<div class="absolute top-40 right-20 text-5xl animate-float" style="animation-delay: 1s;">🍟</div>
		<div class="absolute bottom-20 left-1/4 text-4xl animate-float" style="animation-delay: 2s;">🥤</div>
		<div class="absolute bottom-40 right-1/3 text-5xl animate-float" style="animation-delay: 3s;">🍕</div>
	</div>

	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
		<div class="grid lg:grid-cols-2 gap-12 items-center">
			<!-- Left Content - Image -->
			<div class="animate-scale-in">
				<div class="relative group">
					<img 
						src="https://images.pexels.com/photos/1556909/pexels-photo-1556909.jpeg?auto=compress&cs=tinysrgb&w=600&h=500&fit=crop" 
						alt="Suscríbete Newsletter" 
						class="w-full max-w-lg mx-auto lg:mx-0 rounded-3xl shadow-2xl shadow-black/30 transition-all duration-500 group-hover:scale-105 group-hover:rotate-2"
					>
					<div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent rounded-3xl"></div>
					
					<!-- Floating Badge -->
					<div class="absolute -top-6 -right-6 bg-white text-primary-600 px-6 py-3 rounded-full font-bold text-lg shadow-2xl animate-bounce">
						¡Únete!
					</div>
					
					<!-- Decorative Elements -->
					<div class="absolute -bottom-4 -left-4 w-16 h-16 bg-white/20 rounded-full animate-pulse"></div>
					<div class="absolute -top-4 left-1/3 w-12 h-12 bg-white/30 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
				</div>
			</div>

			<!-- Right Content - Form -->
			<div class="text-center lg:text-left animate-slide-up" style="animation-delay: 0.3s;">
				<div class="space-y-6 mb-8">
					<div class="inline-flex items-center gap-3 bg-white/20 backdrop-blur-md px-6 py-3 rounded-full border border-white/30">
						<span class="text-2xl animate-bounce">📧</span>
						<span class="text-white font-bold uppercase tracking-wider">Newsletter</span>
					</div>
					
					<h2 class="text-4xl lg:text-6xl font-black text-white leading-tight">
						Suscríbete A Nuestro Newsletter
					</h2>
					
					<p class="text-white/90 text-xl leading-relaxed max-w-lg">
						Recibe ofertas exclusivas, nuevos platillos y promociones especiales directamente en tu correo. ¡No te pierdas nada!
					</p>

					<!-- Benefits List -->
					<div class="space-y-3 text-left">
						<div class="flex items-center gap-3 text-white">
							<div class="w-6 h-6 bg-white/20 rounded-full flex items-center justify-center">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none">
									<path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
								</svg>
							</div>
							<span class="font-semibold">Ofertas exclusivas para suscriptores</span>
						</div>
						<div class="flex items-center gap-3 text-white">
							<div class="w-6 h-6 bg-white/20 rounded-full flex items-center justify-center">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none">
									<path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
								</svg>
							</div>
							<span class="font-semibold">Primero en conocer nuevos platillos</span>
						</div>
						<div class="flex items-center gap-3 text-white">
							<div class="w-6 h-6 bg-white/20 rounded-full flex items-center justify-center">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none">
									<path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
								</svg>
							</div>
							<span class="font-semibold">Descuentos especiales en tu cumpleaños</span>
						</div>
					</div>
				</div>

				<!-- Newsletter Form -->
				<form class="space-y-4 max-w-md mx-auto lg:mx-0" id="newsletterForm">
					<div class="flex flex-col sm:flex-row gap-4">
						<input 
							type="email" 
							placeholder="Ingresa tu email..." 
							class="flex-1 px-6 py-4 rounded-full text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-4 focus:ring-white/25 transition-all duration-300 font-semibold"
							required
							id="emailInput"
						>
						<button 
							type="submit" 
							class="bg-dark-900 text-white px-8 py-4 rounded-full font-bold hover:bg-dark-800 hover:scale-105 transition-all duration-300 shadow-lg flex items-center justify-center gap-3 group"
						>
							<span>SUSCRIBIRSE</span>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="group-hover:translate-x-1 transition-transform duration-300">
								<path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
							</svg>
						</button>
					</div>
					
					<!-- Privacy Notice -->
					<p class="text-white/70 text-sm">
						Al suscribirte, aceptas recibir emails promocionales. Puedes darte de baja en cualquier momento.
					</p>
				</form>

				<!-- Social Proof -->
				<div class="flex items-center justify-center lg:justify-start gap-6 mt-8 animate-fade-in" style="animation-delay: 0.6s;">
					<div class="flex -space-x-3">
						<img src="https://images.pexels.com/photos/1239291/pexels-photo-1239291.jpeg?auto=compress&cs=tinysrgb&w=50&h=50&fit=crop" alt="Suscriptor" class="w-12 h-12 rounded-full border-4 border-white">
						<img src="https://images.pexels.com/photos/1181686/pexels-photo-1181686.jpeg?auto=compress&cs=tinysrgb&w=50&h=50&fit=crop" alt="Suscriptor" class="w-12 h-12 rounded-full border-4 border-white">
						<img src="https://images.pexels.com/photos/1681010/pexels-photo-1681010.jpeg?auto=compress&cs=tinysrgb&w=50&h=50&fit=crop" alt="Suscriptor" class="w-12 h-12 rounded-full border-4 border-white">
						<div class="w-12 h-12 bg-white/20 rounded-full border-4 border-white flex items-center justify-center text-white font-bold text-sm">
							+2K
						</div>
					</div>
					<div class="text-white">
						<p class="font-bold">2,000+ suscriptores</p>
						<p class="text-sm text-white/80">Se unieron esta semana</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	document.addEventListener('DOMContentLoaded', function() {
		const form = document.getElementById('newsletterForm');
		const emailInput = document.getElementById('emailInput');
		
		form?.addEventListener('submit', function(e) {
			e.preventDefault();
			
			const email = emailInput.value;
			if (email) {
				// Simulate form submission
				const button = form.querySelector('button[type="submit"]');
				const originalText = button.innerHTML;
				
				button.innerHTML = '<span>Suscribiendo...</span>';
				button.disabled = true;
				
				setTimeout(() => {
					button.innerHTML = '<span>¡Suscrito! ✓</span>';
					button.classList.add('bg-secondary-500', 'hover:bg-secondary-600');
					button.classList.remove('bg-dark-900', 'hover:bg-dark-800');
					
					setTimeout(() => {
						button.innerHTML = originalText;
						button.disabled = false;
						button.classList.remove('bg-secondary-500', 'hover:bg-secondary-600');
						button.classList.add('bg-dark-900', 'hover:bg-dark-800');
						emailInput.value = '';
					}, 3000);
				}, 2000);
			}
		});
	});
</script>